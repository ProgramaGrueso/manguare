{
  "name": "manguare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manguaré — alertas de emergencia con conectividad intermitente (MVP)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/src/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "build:beta": "vite build --config web/vite.config.ts --mode beta-visual",
    "start": "node --env-file-if-exists=.env server/src/index.js",
    "seed": "node server/scripts/seed.js",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --test server/test/*.test.js",
    "test:web": "tsx --test web/test/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.8",
    "puppeteer-core": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
